+// A fresh RecompLauncher install never opens the custom launcher, so no
+// GCPadNew.ini exists and the player cannot pick a pad there. Detect the
+// connected SDL gamepads on every boot and keep a working profile: generate one
+// when absent, and regenerate when the configured pad is no longer connected so
+// swapping Xbox / PlayStation / Switch / generic pads just works.
+//
+// Detection is GUID-level (SDL gamecontrollerdb semantics): SDL resolves each
+// device's GUID to a binding string, and the generated profile uses SDL's
+// normalized buttons (A=south/bottom, B=east/right, X=west/left, Y=north/top).
+// That makes a DualSense Edge or Xbox Elite produce the SAME GameCube input as a
+// standard DualSense / Xbox pad. The family label below is derived from the USB
+// vendor id encoded in the GUID (not the device name); the actual layout is
+// SDL's GUID-keyed mapping, logged verbatim for diagnostics.
+
+// Register pro-controller GUIDs missing from the bundled SDL gamepad DB. The DB
+// ships the DualSense Edge Bluetooth GUID (050000004c050000f20d...) but not the
+// USB GUID (Sony 054C:0DF2). Add the USB variants with the standard DualSense
+// (PS5) USB layout so they normalize identically. Xbox Elite Series 1/2 GUIDs
+// (Microsoft 045E:02E3/0B00/0B05) are already present with the standard Xbox
+// layout. Edge paddles/Fn (misc1) and Elite paddles (paddle1-4) are extra buttons
+// the GameCube profile does not bind -> explicitly ignored (no GC equivalent).
+void RegisterProControllerMappings() {
+  static const char *kEdgeUsbLayout =
+      "a:b1,b:b2,back:b8,dpdown:h0.4,dpleft:h0.8,dpright:h0.2,dpup:h0.1,"
+      "guide:b12,leftshoulder:b4,leftstick:b10,lefttrigger:a3,leftx:a0,lefty:a1,"
+      "misc1:b13,rightshoulder:b5,rightstick:b11,righttrigger:a4,rightx:a2,righty:a5,"
+      "start:b9,x:b0,y:b3,";
+  SDL_AddGamepadMapping(
+      (std::string("030000004c050000f20d000000000000,DualSense Edge Controller,") +
+       kEdgeUsbLayout).c_str());
+  SDL_AddGamepadMapping(
+      (std::string("030000004c050000f20d000000010000,DualSense Edge Controller,") +
+       kEdgeUsbLayout).c_str());
+}
+
+std::string GamepadGuid(SDL_JoystickID id) {
+  char buf[33] = {};
+  SDL_GUIDToString(SDL_GetGamepadGUIDForID(id), buf, sizeof(buf));
+  return std::string(buf);
+}
+
+// SDL GUID hex: VID at chars [8..11], PID at [16..19], little-endian byte pairs.
+void GuidVidPid(const std::string &guid, std::string &vid, std::string &pid) {
+  const auto swap = [](const std::string &s) { return s.substr(2, 2) + s.substr(0, 2); };
+  vid = guid.size() >= 12 ? swap(guid.substr(8, 4)) : "????";
+  pid = guid.size() >= 20 ? swap(guid.substr(16, 4)) : "????";
+}
+
+std::string ReadTextFile(const std::filesystem::path &path) {
+  std::ifstream input(path);
+  return {std::istreambuf_iterator<char>(input),
+          std::istreambuf_iterator<char>()};
+}
+
+std::string ControllerProfileDevice(const std::string &text) {
+  constexpr std::string_view marker = "Device = ";
+  const std::size_t start = text.find(marker);
+  if (start == std::string::npos)
+    return {};
+  const std::size_t begin = start + marker.size();
+  const std::size_t end = text.find_first_of("\r\n", begin);
+  return text.substr(begin, end == std::string::npos ? std::string::npos
+                                                     : end - begin);
+}
+
+moderngekko::frontend::ControllerLayout
+ControllerProfileLayout(const std::string &text) {
+  using moderngekko::frontend::ControllerLayout;
+  if (text.find("Buttons/A = `RETURN`") != std::string::npos)
+    return ControllerLayout::Keyboard;
+  if (text.find("Buttons/A = `Button B`") != std::string::npos)
+    return ControllerLayout::Nintendo;
+  return ControllerLayout::Standard;
+}
+
+struct ControllerDevice {
+  std::string device;
+  std::string guid;
+  std::string mapping;
+};
+
+ControllerDevice ChooseControllerDevice(std::string_view preferred) {
+  constexpr std::string_view keyboard = "DInput/0/Keyboard Mouse";
+  if (preferred == keyboard)
+    return {std::string(keyboard), {}, {}};
+
+  int count = 0;
+  SDL_JoystickID *ids = SDL_GetJoysticks(&count);
+  ControllerDevice first;
+  ControllerDevice match;
+  if (ids) {
+    for (int i = 0; i < count; ++i) {
+      if (!SDL_IsGamepad(ids[i]))
+        continue;
+      const char *name = SDL_GetGamepadNameForID(ids[i]);
+      if (!name || !*name)
+        continue;
+      ControllerDevice candidate;
+      candidate.device = "SDL/0/" + std::string(name);
+      candidate.guid = GamepadGuid(ids[i]);
+      char *mapping = SDL_GetGamepadMappingForID(ids[i]);
+      candidate.mapping = mapping ? mapping : "";
+      SDL_free(mapping);
+      if (first.device.empty())
+        first = candidate;
+      if (candidate.device == preferred)
+        match = candidate;
+    }
+  }
+  SDL_free(ids);
+  return !match.device.empty() ? match : first;
+}
+
+// Startup diagnostic: name / GUID / VID:PID / layout / dpad, plus SDL's
+// GUID-resolved mapping string and the profile action. Players can send these
+// two lines for support; --list-controllers prints the same per pad.
+void LogControllerDiagnostic(const ControllerDevice &dev,
+                             const moderngekko::frontend::ControllerMapping &mapping) {
+  std::string vid, pid;
+  GuidVidPid(dev.guid, vid, pid);
+  const bool keyboard = mapping.layout ==
+                        moderngekko::frontend::ControllerLayout::Keyboard;
+  std::cerr << "controller: name=\""
+            << (dev.device.empty() ? "none (keyboard fallback)" : dev.device)
+            << "\" guid=" << (dev.guid.empty() ? "n/a" : dev.guid)
+            << " vid=" << (dev.guid.empty() ? "n/a" : vid)
+            << " pid=" << (dev.guid.empty() ? "n/a" : pid) << " layout="
+            << moderngekko::frontend::ControllerLayoutName(mapping.layout)
+            << " dpad=" << (mapping.swap_dpad_lr ? "swapped" : "normal")
+            << " source=" << (keyboard ? "keyboard" : "sdl") << '\n';
+  if (!dev.mapping.empty())
+    std::cerr << "controller:   sdl_mapping=" << dev.mapping << '\n';
+}
+
+// Console-only probe (no game boot, no window): list connected gamepads with the
+// GUID/layout diagnostic. Useful for players to confirm a pad is recognized.
+int ListControllers() {
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+    std::cerr << "controller: SDL init failed: " << SDL_GetError() << '\n';
+    return 1;
+  }
+  RegisterProControllerMappings();
+  SDL_PumpEvents();
+  SDL_Delay(150);
+  int count = 0;
+  int pads = 0;
+  SDL_JoystickID *ids = SDL_GetJoysticks(&count);
+  if (ids) {
+    for (int i = 0; i < count; ++i) {
+      if (!SDL_IsGamepad(ids[i]))
+        continue;
+      const char *name = SDL_GetGamepadNameForID(ids[i]);
+      ControllerDevice dev;
+      dev.device = std::string("SDL/0/") + (name && *name ? name : "Unknown Controller");
+      dev.guid = GamepadGuid(ids[i]);
+      char *mapping = SDL_GetGamepadMappingForID(ids[i]);
+      dev.mapping = mapping ? mapping : "";
+      SDL_free(mapping);
+      const auto resolved =
+          moderngekko::frontend::DetectControllerMapping(dev.device, dev.mapping, dev.guid);
+      LogControllerDiagnostic(dev, resolved);
+      ++pads;
+    }
+  }
+  SDL_free(ids);
+  if (pads == 0)
+    std::cerr << "controller: no SDL gamepad detected\n";
+  SDL_Quit();
+  return 0;
+}
+
+// Wait up to `timeout_ms` for a gamepad to appear. Bluetooth Xbox pads, DualSense
+// and pads behind a hub can take several hundred milliseconds to enumerate, and
+// this detect runs before the window exists. Concluding "no pad" too early used
+// to replace a working Xbox profile with the keyboard one (v0.1.5 regression).
+bool WaitForGamepad(int timeout_ms) {
+  const auto deadline = std::chrono::steady_clock::now() +
+                        std::chrono::milliseconds(timeout_ms);
+  for (;;) {
+    int count = 0;
+    bool found = false;
+    SDL_JoystickID *ids = SDL_GetJoysticks(&count);
+    if (ids) {
+      for (int i = 0; i < count && !found; ++i)
+        found = SDL_IsGamepad(ids[i]);
+    }
+    SDL_free(ids);
+    if (found)
+      return true;
+    if (std::chrono::steady_clock::now() >= deadline)
+      return false;
+    SDL_PumpEvents();
+    SDL_Delay(50);
+  }
+}
+
+// Detect the connected pad, choose its button family from the LIVE SDL mapping
+// (per GUID, not name), and keep a working profile. Default profiles migrate to
+// the detected layout; hand-edited (custom) profiles are preserved; an explicit
+// controller_layout / --controller-layout forces a layout. Mirrors the WMX8 fix
+// for 8BitDo Nintendo-layout pads (A/B and X/Y reversed) without a blanket rule.
+void EnsureDefaultControllerConfig(
+    const std::filesystem::path &user_directory,
+    moderngekko::frontend::ControllerLayout requested_layout,
+    std::string_view preferred_device) {
+  using moderngekko::frontend::ControllerLayout;
+  using moderngekko::frontend::ControllerMapping;
+
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+    std::cerr << "controller: SDL init failed: " << SDL_GetError() << '\n';
+    return;
+  }
+  RegisterProControllerMappings();
+
+  constexpr std::string_view keyboard_device = "DInput/0/Keyboard Mouse";
+  const bool keyboard_requested = requested_layout == ControllerLayout::Keyboard;
+  // A pad that is switched on but not enumerated yet must not read as "absent".
+  if (!keyboard_requested)
+    WaitForGamepad(800);
+  ControllerDevice chosen =
+      keyboard_requested ? ControllerDevice{} : ChooseControllerDevice(preferred_device);
+  const bool pad_missing = !keyboard_requested && chosen.device.empty();
+  std::string device = chosen.device;
+  if (keyboard_requested || device.empty())
+    device = std::string(keyboard_device);
+
+  ControllerMapping mapping =
+      moderngekko::frontend::DetectControllerMapping(device, chosen.mapping,
+                                                     chosen.guid);
+  if (device == keyboard_device) {
+    mapping = {ControllerLayout::Keyboard, false};
+  } else if (requested_layout != ControllerLayout::Auto) {
+    mapping.layout = requested_layout;
+  }
+  if (mapping.layout == ControllerLayout::Keyboard)
+    mapping.swap_dpad_lr = false;
+
+  const std::filesystem::path profile_path =
+      user_directory / "Config" / "GCPadNew.ini";
+  const std::string existing = ReadTextFile(profile_path);
+  const bool exists = !existing.empty();
+  const std::string existing_device = ControllerProfileDevice(existing);
+  const ControllerLayout existing_layout = ControllerProfileLayout(existing);
+  const bool existing_dpad_swapped =
+      moderngekko::frontend::ControllerProfileDpadSwapped(existing);
+
+  // No pad this boot (and the player did not ask for the keyboard): never write
+  // the keyboard fallback over a real controller profile. v0.1.5 did, so an
+  // Xbox pad that was off, asleep or still pairing when the game started lost
+  // its profile and then produced no input at all - the reported "Xbox
+  // controllers not working" regression. Keep the profile, say why, and only
