 void HandleStopSignal(int) { s_stop_requested = 1; }
 
+// A fresh RecompLauncher install never opens the custom launcher, so no
+// GCPadNew.ini exists and the player cannot pick a pad there. Detect the
+// connected SDL gamepads on every boot and keep a working profile: generate one
+// when absent, and regenerate when the configured pad is no longer connected so
+// swapping Xbox / PlayStation / Switch / generic pads just works. The mapping
+// uses SDL's normalized buttons, which are position-consistent across families
+// (A=bottom, B=right, X=left, Y=top).
+const char *ControllerFamily(const std::string &name) {
+  std::string lower;
+  lower.reserve(name.size());
+  for (char c : name)
+    lower.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(c))));
+  const auto has = [&lower](const char *needle) {
+    return lower.find(needle) != std::string::npos;
+  };
+  if (has("xbox") || has("xinput") || has("microsoft"))
+    return "Xbox";
+  if (has("dualsense") || has("dualshock") || has("playstation") || has("ps5") ||
+      has("ps4") || has("sony"))
+    return "PlayStation";
+  if (has("switch") || has("pro controller") || has("joy-con") || has("nintendo"))
+    return "Switch";
+  return "generic";
+}
+
+// "SDL/<index>/<name>" -> "<name>" so matching ignores the SDL device index.
+std::string ControllerDeviceName(const std::string &device) {
+  const std::size_t first = device.find('/');
+  if (first == std::string::npos)
+    return device;
+  const std::size_t second = device.find('/', first + 1);
+  if (second == std::string::npos)
+    return device.substr(first + 1);
+  return device.substr(second + 1);
+}
+
+void EnsureDefaultControllerConfig(const std::filesystem::path &user_directory) {
+  if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
+    std::cerr << "controller: SDL init failed: " << SDL_GetError() << '\n';
+    return;
+  }
+
+  // Enumerate connected gamepads, mirroring the launcher's device-string format.
+  std::vector<std::string> devices;
+  std::vector<std::string> names;
+  std::unordered_map<std::string, int> seen;
+  int count = 0;
+  SDL_JoystickID *ids = SDL_GetJoysticks(&count);
+  if (ids) {
