+int HexNibble(char c) {
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  return -1;
+}
+
+std::optional<std::uint16_t> GuidWord(std::string_view guid,
+                                      std::size_t offset) {
+  if (guid.size() < offset + 4)
+    return std::nullopt;
+  const int low = HexNibble(guid[offset]);
+  const int low2 = HexNibble(guid[offset + 1]);
+  const int high = HexNibble(guid[offset + 2]);
+  const int high2 = HexNibble(guid[offset + 3]);
+  if (low < 0 || low2 < 0 || high < 0 || high2 < 0)
+    return std::nullopt;
+  return static_cast<std::uint16_t>((low << 4) | low2 |
+                                    (((high << 4) | high2) << 8));
+}
+
+enum class ControllerGuidFamily { Unknown, DualSenseEdge, XboxElite };
+
+ControllerGuidFamily ClassifyControllerGuid(std::string_view guid) {
+  const std::optional<std::uint16_t> vendor = GuidWord(guid, 8);
+  const std::optional<std::uint16_t> product = GuidWord(guid, 16);
+  if (!vendor || !product)
+    return ControllerGuidFamily::Unknown;
+  if (*vendor == 0x054c && *product == 0x0df2)
+    return ControllerGuidFamily::DualSenseEdge;
+  if (*vendor == 0x045e &&
+      (*product == 0x02e3 || *product == 0x0b00 || *product == 0x0b05 ||
+       *product == 0x0b12 || *product == 0x0b13 || *product == 0x0b20 ||
+       *product == 0x0b22))
+    return ControllerGuidFamily::XboxElite;
+  return ControllerGuidFamily::Unknown;
+}
+
+// Vendors whose pads are printed positionally: the bottom button is "confirm",
+// the right one is "back", exactly like the GameCube A/B. Their SDL rows bind
+// "a" to the bottom button on every firmware we ship rows for, so the GameCube
+// profile must never swap their face buttons. Guarding by vendor (instead of a
+// per-product GUID list) means a new Xbox/PlayStation model, revision or
+// Bluetooth GUID cannot regress: 0x045E covers every Xbox 360/One/Series/Elite
+// report, 0x054C covers PS3/PS4/DualSense/DualSense Edge and 0x28DE the Steam
+// Deck / Steam virtual pad.
+bool IsPositionalVendor(std::uint16_t vendor) {
+  return vendor == 0x045e || vendor == 0x054c || vendor == 0x28de;
+}
+
+// 8BitDo (0x2DC8) ships two different raw button orders: the Nintendo-mode
+// reports (Pro 2, SN30, SF30, N30, FC30, Zero, Micro) put the right-hand
+// "A" button on a higher raw index than "B", while the positional families
+// (Ultimate, Ultimate 2C, 64, M30) keep bottom=0/right=1. Only this vendor is
+// classified from the a/b index; every other pad keeps the name-based rule so
+// PS3/PS2/generic pads (which also use a>b in the SDL DB) stay unswapped.
+bool IsEightBitDoVendor(std::uint16_t vendor) { return vendor == 0x2dc8; }
+
+bool IsNintendoName(const std::string &lower) {
+  return lower.find("switch") != std::string::npos ||
+         lower.find("joy-con") != std::string::npos ||
+         lower.find("joycon") != std::string::npos ||
+         lower.find("nintendo") != std::string::npos ||
+         lower.find("pro controller") != std::string::npos ||
+         lower.find("wii u") != std::string::npos;
+}
+
+std::string_view MappingValue(std::string_view mapping, std::string_view key) {
+  std::string needle(key);
+  needle += ':';
+  std::size_t position = 0;
+  while ((position = mapping.find(needle, position)) != std::string_view::npos) {
+    if (position == 0 || mapping[position - 1] == ',') {
+      const std::size_t begin = position + needle.size();
+      const std::size_t end = mapping.find(',', begin);
+      return mapping.substr(begin, end == std::string_view::npos
+                                      ? std::string_view::npos
+                                      : end - begin);
+    }
+    position += needle.size();
+  }
+  return {};
+}
+
+std::optional<int> ButtonIndex(std::string_view value) {
+  if (value.size() < 2 || value.front() != 'b')
+    return std::nullopt;
+  int index = 0;
+  const auto parsed =
+      std::from_chars(value.data() + 1, value.data() + value.size(), index);
+  if (parsed.ec != std::errc{} || parsed.ptr != value.data() + value.size())
+    return std::nullopt;
+  return index;
+}
