+// Memory card layout, forced for every launch (GUI, RecompLauncher and plain
+// runner alike - a launcher-only migration would miss RecompLauncher installs,
+// which start the runner directly):
+//   slot A = 1   (EXIDeviceType::MemoryCard, a raw GC/MemoryCardA.<region>.raw)
+//   slot B = 255 (EXIDeviceType::None, genuinely empty)
+// Slot A's default (8, MemoryCardFolder) needs GC/<region>/Card A and makes the
+// boot-time "checking memory card in slot A" probe stall on a fresh user dir.
+// Slot B must never be 0 (Dummy, a non-card EXI device): the game aborts with
+// "THE DEVICE IN SLOT B IS NOT SUPPORTED" and the new-file flow never opens.
+// Written to Config/Dolphin.ini (so later boots start correct) and pushed into
+// the config base layer (so this process uses it even if SConfig already cached
+// the old values).
+void ForceMemoryCardLayout(const std::filesystem::path& user_directory)
+{
+  std::error_code ec;
+  std::filesystem::create_directories(user_directory / "Config", ec);
+  const std::filesystem::path ini_path = user_directory / "Config" / "Dolphin.ini";
+
+  Common::IniFile ini;
+  ini.Load(ini_path.string());
+  Common::IniFile::Section* core = ini.GetOrCreateSection("Core");
+  int slot_a = 8;
+  int slot_b = 0;
+  core->Get("SlotA", &slot_a);
+  core->Get("SlotB", &slot_b);
+  if (slot_a != static_cast<int>(ExpansionInterface::EXIDeviceType::MemoryCard) ||
+      slot_b != static_cast<int>(ExpansionInterface::EXIDeviceType::None))
+  {
+    core->Set("SlotA", "1");
+    core->Set("SlotB", "255");
+    if (ini.Save(ini_path.string()))
+      std::fprintf(stderr, "[memcard] migrated %s: SlotA=1 (raw card), SlotB=255 (none)\n",
+                   ini_path.string().c_str());
+    else
+      std::fprintf(stderr, "[memcard] could not write %s\n", ini_path.string().c_str());
+  }
+  // NOTE: no Config::SetBase here. The config layers are not initialised until
+  // UICommon::Init(), and touching them this early crashes (0xC0000005). SConfig
+  // reads Config/Dolphin.ini during UICommon::Init, so writing the keys first is
+  // enough - and it is what makes the setting stick for later boots too.
+  std::fprintf(stderr, "[memcard] slot A=raw card, slot B=none\n");
+}
