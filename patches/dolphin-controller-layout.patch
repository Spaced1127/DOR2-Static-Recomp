+// Canonical layout classes: the whole per-pad decision lives here, so no
+// controller profile, GUID table or name heuristic can decide button order.
+namespace
+{
+// 8BitDo pads in Switch mode normally report SDL_GAMEPAD_TYPE_NINTENDO_SWITCH_PRO.
+// Some firmware revisions report UNKNOWN, so fall back to vendor/product words
+// the pads present in that mode. Extend only with GUIDs observed on real
+// hardware (each entry is a claim the offline matrix cannot verify).
+bool IsEightBitDoSwitchClone(SDL_Gamepad* const gamepad)
+{
+  if (!gamepad)
+    return false;
+  SDL_Joystick* const joystick = SDL_GetGamepadJoystick(gamepad);
+  if (!joystick)
+    return false;
+  char text[33]{};
+  SDL_GUIDToString(SDL_GetJoystickGUID(joystick), text, sizeof(text));
+  struct VendorProduct
+  {
+    const char* vendor;
+    const char* product;
+  };
+  // Vendor/product words as they appear in the GUID string (little-endian pairs).
+  static constexpr VendorProduct kSwitchClones[] = {
+      {"ac05", "0400"},  // 05ac:0004 - 8BitDo Switch-mode report over Bluetooth
+      {"c82d", "0400"},  // 2dc8:0004 - 8BitDo Switch-mode report, USB variant
+  };
+  for (const VendorProduct& clone : kSwitchClones)
+  {
+    if (std::strncmp(text + 8, clone.vendor, 4) == 0 &&
+        std::strncmp(text + 16, clone.product, 4) == 0)
+      return true;
+  }
+  return false;
+}
+}  // namespace
+
+LayoutClass ClassifyGamepad(SDL_Gamepad* const gamepad)
+{
+  const int type = gamepad ? static_cast<int>(SDL_GetGamepadType(gamepad))
+                           : static_cast<int>(SDL_GAMEPAD_TYPE_UNKNOWN);
+  return ResolveLayoutClass(GetLayoutClassOverride(), type,
+                            IsEightBitDoSwitchClone(gamepad));
+}
+
+SDL_GamepadButton ResolveLayoutButton(LayoutClass layout_class, SDL_GamepadButton button)
+{
+  if (layout_class != LayoutClass::Nintendo)
+    return button;
+  switch (button)
+  {
+  case SDL_GAMEPAD_BUTTON_SOUTH:
+    return SDL_GAMEPAD_BUTTON_EAST;
+  case SDL_GAMEPAD_BUTTON_EAST:
+    return SDL_GAMEPAD_BUTTON_SOUTH;
+  case SDL_GAMEPAD_BUTTON_WEST:
+    return SDL_GAMEPAD_BUTTON_NORTH;
+  case SDL_GAMEPAD_BUTTON_NORTH:
+    return SDL_GAMEPAD_BUTTON_WEST;
+  default:
+    return button;
+  }
+}
+
