#include <winver.h>

1 ICON "dor2.ico"

1 VERSIONINFO
FILEVERSION     0,1,2,0
PRODUCTVERSION  0,1,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "DOR2 Static Recomp"
            VALUE "FileDescription",  "WWE Day of Reckoning 2 Disc Preparer"
            VALUE "FileVersion",      "0.1.2.0"
            VALUE "InternalName",     "DOR2Prepare"
            VALUE "LegalCopyright",   "GPL-3.0. No game data included."
            VALUE "OriginalFilename", "DOR2Prepare.exe"
            VALUE "ProductName",      "DOR2 Static Recomp"
            VALUE "ProductVersion",   "0.1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
